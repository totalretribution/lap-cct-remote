#!/bin/sh
# Gives the radio helper the one capability it needs. Any user can run it.
set -e

HELPER=/usr/libexec/light-radio

if [ "$1" = configure ]; then
    chown root:root "$HELPER"
    chmod 0755 "$HELPER"
    setcap cap_net_raw+ep "$HELPER"
    # 0.1.3 and older limited the helper to this group; it's no longer used
    if getent group light-remote >/dev/null; then
        groupdel light-remote || true
    fi
fi

exit 0
