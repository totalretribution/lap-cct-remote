#!/bin/sh
# Lets members of the light-remote group run the radio helper, with the one capability it needs.
set -e

GROUP=light-remote
HELPER=/usr/libexec/light-radio

# Adds the person installing (through sudo or pkexec) to the group, so they don't have to.
add_installer() {
    user=""
    if [ -n "${SUDO_USER:-}" ]; then
        user="$SUDO_USER"
    elif [ -n "${PKEXEC_UID:-}" ]; then
        user="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
    fi
    if [ -n "$user" ] && [ "$user" != root ] && ! id -nG "$user" | tr ' ' '\n' | grep -qx "$GROUP"; then
        usermod -aG "$GROUP" "$user"
        echo "light-remote: added $user to the $GROUP group; log out and back in to use the light."
    fi
}

if [ "$1" = configure ]; then
    getent group "$GROUP" >/dev/null || groupadd -r "$GROUP"
    chown root:"$GROUP" "$HELPER"
    chmod 0750 "$HELPER"
    setcap cap_net_raw+ep "$HELPER"
    add_installer
    echo "light-remote: other users need adding with: sudo usermod -aG $GROUP <user>"
fi

exit 0
